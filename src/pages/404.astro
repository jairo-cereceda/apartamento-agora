---
import Layout from '@layouts/Layout.astro';
import '@styles/main.css';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

const metadata = await getImageMetadata('imgs/banner.jpg');
---

<Layout pageTitle="Apartamento Agora | 404 not found">
  <div class="w-full h-full relative">
    <div
      class="bg-secondary/80 w-full h-full absolute top-0 left-0 flex justify-center items-center"
    >
      <div class="max-w-[90%] flex flex-col gap-4">
        <h1 class="text-center text-2xl font-semibold">404 not found</h1>

        <p class="uppercase font-semibold">
          Parece que por aquí no se sale del apartamento...
        </p>
        <p>Te recomendamos ver que ofrecemos:</p>
        <a
          href="/"
          class="bg-primary text-white px-4 py-2 rounded-2xl transition-colors duration-150 hover:bg-primary-dark active:bg-primary-dark"
          >Ir al inicio</a
        >
      </div>
    </div>

    <Image
      src={metadata}
      width={metadata.width}
      height={metadata.height}
      class="object-cover h-screen max-h-medium lg:max-h-medium-big"
      alt=""
    />
  </div>
</Layout>
