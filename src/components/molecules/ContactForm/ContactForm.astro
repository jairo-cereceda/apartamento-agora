<div class="flex flex-col text-primary gap-4">
  <h2 class="text-center text-xl font-semibold">
    ¿Tienes una consulta más profunda?
  </h2>
  <form
    class="flex flex-col gap-4 bg-white p-2 rounded-xl sm:p-6 border lg:border-none"
  >
    <div>
      <label for="name" class="w-full text-start">Tu nombre:</label>
      <input
        type="text"
        name="name"
        id="name"
        class="rounded-lg border w-full p-2"
      />
    </div>
    <div>
      <label for="email">Tu correo:</label>
      <input
        type="text"
        name="email"
        id="email"
        class="rounded-lg border w-full p-2"
      />
    </div>
    <div>
      <label for="message">Mensaje:</label>
      <textarea id="message" class="rounded-lg border w-full p-2"></textarea>
    </div>
    <button
      type="button"
      data-open-fictional-popup
      class="bg-primary px-4 py-2 rounded-full text-white font-semibold cursor-pointer transition-colors duration-150 hover:bg-primary-dark active:bg-primary-dark"
      >Enviar</button
    >
    <p class="text-xs text-black/70">
      Esta web es ficticia, no recopilamos datos de ningún tipo
    </p>
  </form>
</div>
